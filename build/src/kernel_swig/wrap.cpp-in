SWIGINTERN int
SWIG_AsVal_unsigned_SS_int (PyObject * obj, unsigned int *val)
{
  unsigned long v;
  int res = SWIG_AsVal_unsigned_SS_long (obj, &v);
  if (SWIG_IsOK(res)) {
    if ((v > UINT_MAX)) {
      return SWIG_OverflowError;
    } else {
      if (val) *val = static_cast< unsigned int >(v);
    }
  }  
  return res;
}


SWIGINTERNINLINE PyObject*
  SWIG_From_unsigned_SS_int  (unsigned int value)
{
  return PyInt_FromSize_t((size_t) value);
}

SWIGINTERN bool IMP_Object___eq__(IMP::Object const *self,IMP::Object const *o){
     return self ==o;
  }
SWIGINTERN bool IMP_Object___ne__(IMP::Object const *self,IMP::Object const *o){
     return self !=o;
  }
SWIGINTERN bool IMP_Object___le__(IMP::Object const *self,IMP::Object const *o){
     return self <= o;
  }
SWIGINTERN bool IMP_Object___lt__(IMP::Object const *self,IMP::Object const *o){
     return self < o;
  }
SWIGINTERN bool IMP_Object___ge__(IMP::Object const *self,IMP::Object const *o){
     return self >= o;
  }
SWIGINTERN bool IMP_Object___gt__(IMP::Object const *self,IMP::Object const *o){
     return self > o;
  }
SWIGINTERN PyObject *IMP_Object__get_director_object(IMP::Object *self){
    Swig::Director *d = dynamic_cast<Swig::Director *>(self);
    if (d) {
      PyObject *pyobj = d->swig_get_self();
      Py_INCREF(pyobj);
      return pyobj;
    } else {
      return Py_None;
    }
  }
