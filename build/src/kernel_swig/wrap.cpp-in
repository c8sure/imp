#include "wrap.h-in"

SwigDirector_Object::SwigDirector_Object(PyObject *self,std::string name): IMP::Object(name), Swig::Director(self) {
  SWIG_DIRECTOR_RGTR((IMP::Object *)this, this); 
}




SwigDirector_Object::~SwigDirector_Object() {
