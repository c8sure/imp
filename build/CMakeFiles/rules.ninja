#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /home/catherine/miniforge3/envs/imp/bin/cmake --regenerate-during-build -S/home/catherine/imp -B/home/catherine/imp/build
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning additional files.

rule CLEAN_ADDITIONAL
  command = /home/catherine/miniforge3/envs/imp/bin/cmake -DCONFIG=$CONFIG -P CMakeFiles/clean_additional.cmake
  description = Cleaning additional files...


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/catherine/miniforge3/envs/imp/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/catherine/miniforge3/envs/imp/bin/ninja -t targets
  description = All primary targets available:

