<codeline><highlight class="normal"></highlight><highlight class="preprocessor">#endif<sp/></highlight><highlight class="comment">/*<sp/>IMPEXAMPLE_EXAMPLE_UNARY_FUNCTION_H<sp/>*/</highlight><highlight class="preprocessor"></highlight></codeline>
</programlisting> </para>
