        <definition>virtual int IMP::domino::SubsetFilter::get_next_state</definition>
        <argsstring>(int pos, const Assignment &amp;state) const</argsstring>
        <name>get_next_state</name>
        <qualifiedname>IMP::domino::SubsetFilter::get_next_state</qualifiedname>
        <param>
          <type>int</type>
          <declname>pos</declname>
        </param>
