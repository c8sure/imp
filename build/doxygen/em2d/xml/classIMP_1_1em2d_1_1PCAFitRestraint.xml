        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">particles</parametername>
</parameternamelist>
<parameterdescription>
<para>The particles participating in the score, which need to have XYZ, radius and mass </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">image_files</parametername>
</parameternamelist>
<parameterdescription>
