<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/>img_size)</highlight></codeline>
<codeline><highlight class="normal">ccs.set_model_particles(IMP.atom.get_leaves(prot))</highlight></codeline>
<codeline><highlight class="normal">print(</highlight><highlight class="stringliteral">&quot;CCS&quot;</highlight><highlight class="normal">,<sp/>ccs.get_ccs(),<sp/></highlight><highlight class="stringliteral">&quot;A**2&quot;</highlight><highlight class="normal">)</highlight></codeline>
